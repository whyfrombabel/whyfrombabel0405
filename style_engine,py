import numpy as np
import librosa
from scipy.spatial.distance import cosine
from sklearn.preprocessing import StandardScaler
import os
import json

# 风格特征索引（应预先从大量歌曲中提取）
_STYLE_DB = []
_STYLE_SCALER = None

def extract_style_features(file_path, sr=22050):
    y, sr = librosa.load(file_path, sr=sr, mono=True)
    y, _ = librosa.effects.trim(y, top_db=20)
    if len(y) < sr * 0.5:
        raise ValueError("音频太短")
    mfcc = librosa.feature.mfcc(y=y, sr=sr, n_mfcc=20)
    mfcc_mean = np.mean(mfcc, axis=1)
    mfcc_std = np.std(mfcc, axis=1)
    cent = librosa.feature.spectral_centroid(y=y, sr=sr)
    cent_mean, cent_std = np.mean(cent), np.std(cent)
    zcr = librosa.feature.zero_crossing_rate(y)
    zcr_mean, zcr_std = np.mean(zcr), np.std(zcr)
    rolloff = librosa.feature.spectral_rolloff(y=y, sr=sr)
    rolloff_mean, rolloff_std = np.mean(rolloff), np.std(rolloff)
    return np.concatenate([mfcc_mean, mfcc_std,
                           [cent_mean, cent_std, zcr_mean, zcr_std, rolloff_mean, rolloff_std]])

def recommend_style(query_audio, top_n=10, genre=None):
    global _STYLE_DB, _STYLE_SCALER
    if not _STYLE_DB:
        # 若索引为空，返回一个示例结果（实际应返回错误）
        return [{'name': '请先建立风格索引', 'artist': '', 'cover': '', 'similarity': 0}]
    q_feat = extract_style_features(query_audio)
    q_feat_scaled = _STYLE_SCALER.transform([q_feat])[0]
    sims = [1 - cosine(q_feat_scaled, item['feature']) for item in _STYLE_DB]
    sorted_indices = np.argsort(sims)[::-1][:top_n]
    results = []
    for idx in sorted_indices:
        item = _STYLE_DB[idx]
        results.append({
            'name': item['song_info']['name'],
            'artist': item['song_info']['artist'],
            'cover': item['song_info']['cover'],
            'play_url': item['song_info']['url'],
            'similarity': sims[idx]
        })
    return results

def load_style_index(index_path='style_index.npz'):
    global _STYLE_DB, _STYLE_SCALER
    data = np.load(index_path, allow_pickle=True)
    _STYLE_DB = data['db']
    _STYLE_SCALER = StandardScaler()
    _STYLE_SCALER.mean_ = data['scaler_mean']
    _STYLE_SCALER.scale_ = data['scaler_scale']
